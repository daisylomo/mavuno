# Application settings. Secrets must be injected by the deployment environment.
MAVUNO_ENVIRONMENT=local
MAVUNO_DEBUG=false
MAVUNO_LOG_LEVEL=INFO
MAVUNO_LOG_CONFIG_PATH=conf/logging.yaml

# JSON-encoded list. Keep empty for mobile-only API access.
MAVUNO_CORS_ORIGINS=[]

# MySQL URL. Percent-encode special characters in credentials.
# Keep the async aiomysql driver in the scheme.
MAVUNO_DATABASE_URL=mysql+aiomysql://mavuno:change-me@127.0.0.1:3306/mavuno?charset=utf8mb4
MAVUNO_DATABASE_POOL_SIZE=5
MAVUNO_DATABASE_MAX_OVERFLOW=10
MAVUNO_DATABASE_POOL_RECYCLE_SECONDS=1800

# JSON object of key IDs to secrets. Keep old keys while their access tokens remain valid.
# Generate each secret using a cryptographically secure random source (at least 32 characters).
MAVUNO_AUTH_ACTIVE_KEY_ID=local-v1
MAVUNO_AUTH_SIGNING_KEYS={"local-v1":"replace-with-a-random-secret-at-least-32-characters"}
MAVUNO_AUTH_ISSUER=mavuno-api
MAVUNO_AUTH_AUDIENCE=mavuno-mobile
MAVUNO_AUTH_ACCESS_TOKEN_MINUTES=15
MAVUNO_AUTH_REFRESH_TOKEN_DAYS=30
MAVUNO_AUTH_RATE_LIMIT_WINDOW_SECONDS=60
MAVUNO_AUTH_REGISTER_RATE_LIMIT=5
MAVUNO_AUTH_LOGIN_RATE_LIMIT=10
MAVUNO_AUTH_REFRESH_RATE_LIMIT=20
MAVUNO_AUTH_RATE_LIMIT_MAX_ENTRIES=10000

# Generate an independent HMAC secret (for example: `openssl rand -hex 32`).
MAVUNO_PUSH_TOKEN_HASH_KEY=replace-with-at-least-32-random-characters
# Generate with Fernet.generate_key(); this must differ from the HMAC secret.
MAVUNO_PUSH_TOKEN_ENCRYPTION_KEY=replace-with-a-url-safe-base64-fernet-key

# Orders and Kenyan payment rails. Keep disabled until sandbox credentials are injected.
MAVUNO_ORDER_RESERVATION_MINUTES=15
MAVUNO_PAYMENTS_ENABLED=false
MAVUNO_DARAJA_ENVIRONMENT=sandbox
MAVUNO_DARAJA_SANDBOX_BASE_URL=https://sandbox.safaricom.co.ke
MAVUNO_DARAJA_PRODUCTION_BASE_URL=https://api.safaricom.co.ke
MAVUNO_DARAJA_CONSUMER_KEY=
MAVUNO_DARAJA_CONSUMER_SECRET=
MAVUNO_DARAJA_SHORTCODE=
MAVUNO_DARAJA_PASSKEY=
MAVUNO_DARAJA_CALLBACK_BASE_URL=https://api.example.test
MAVUNO_DARAJA_CALLBACK_TOKEN=replace-with-at-least-32-random-characters
MAVUNO_DARAJA_REQUEST_TIMEOUT_SECONDS=10
MAVUNO_DARAJA_RETRY_LIMIT=3

# Bank rail remains disabled until a regulated Kenyan provider is selected.
MAVUNO_BANK_PROVIDER_NAME=
MAVUNO_BANK_BASE_URL=
MAVUNO_BANK_CLIENT_ID=
MAVUNO_BANK_CLIENT_SECRET=
MAVUNO_WORKER_POLL_SECONDS=2
